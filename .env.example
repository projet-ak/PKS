# PostgreSQL baglantisi
DATABASE_URL=postgres://pks:pks@localhost:5432/pks

# API sunucusu
PKS_BIND_ADDR=0.0.0.0:8080

# JWT imzalama anahtari (uretimde mutlaka degistir)
PKS_JWT_SECRET=degistir-bu-anahtari

# Ayni ArUco markerin tekrar okunmasini yok sayma suresi (saniye)
PKS_SCAN_DEBOUNCE_SECONDS=30
